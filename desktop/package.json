{
  "name": "preciosaldia-lan-desktop",
  "version": "1.0.0",
  "description": "Aplicación de escritorio multicaja en red local (LAN) para Precios al Día",
  "main": "main.js",
  "type": "commonjs",
  "author": "Precios al Día",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.preciosaldia.lan",
    "productName": "Precios al Día LAN",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "server/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "luiggiberaldi",
        "repo": "precios-al-dia-lan",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "../supabase/nube/migrations",
        "to": "migrations"
      },
      {
        "from": "../dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../public/pwa-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Precios al Día LAN",
      "artifactName": "Precios-al-Dia-LAN-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
